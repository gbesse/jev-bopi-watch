{
  "name": "@gbesse/jev-bopi-watch",
  "version": "0.1.1",
  "description": "Priorise les dépôts de marques françaises potentiellement conflictuels après filtrage par classe, territoire et statut.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./jev": {
      "types": "./src/jev.d.mts",
      "import": "./src/jev.mjs"
    }
  },
  "bin": {
    "jev-bopi-watch": "./bin/jev-bopi-watch.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "test": "node --test",
    "demo": "node examples/demo.mjs",
    "validate": "npm run check && npm run typecheck && npm test && npm run demo"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/jev-bopi-watch.git"
  },
  "keywords": [
    "jev",
    "typesafe-ai",
    "bopi",
    "france",
    "inpi",
    "jev",
    "trademarks"
  ],
  "files": [
    "src",
    "bin",
    "docs",
    "examples",
    "scripts"
  ]
}
